generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Enrollments {
  id              BigInt    @id @default(autoincrement())
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  Student_ID      BigInt?
  Studnet_Name    String?
  Subject_Name    String?
  Subject_ID      BigInt?
  AccessExpiresAt DateTime? @db.Timestamptz(6)

  @@unique([Student_ID, Subject_ID], map: "Enrollments_Student_Subject_key")
}

model Payments {
  id         BigInt         @id @default(autoincrement())
  created_at DateTime       @default(now()) @db.Timestamptz(6)
  Subject    String
  Subject_ID BigInt?
  Student_ID BigInt
  Amount     Decimal
  Method     String
  Status     paymentStatus? @default(Pending)
  Slip_Url   String?
}

model Student {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  Student_ID      BigInt   @unique @default(autoincrement())
  Name            String   @unique
  Email           String
  Watsapp_Number  String
  NIC             Decimal?
  Gurdian_s_Name  String   @map("Gurdian's_Name")
  Gurdians_Number String
  Address         String
  Role            String   @default("student")

  @@map("Studnets")
}

model Subjects {
  id              BigInt   @id @default(autoincrement())
  Name            String
  Grade           Decimal
  Price           Decimal
  Instructor      String
  Medium          String
  MeetingLink     String
  CalendarEventId String?
  Day             String?
  StartTime       String?
  EndTime         String?
  Image           String?
  IsHidden        Boolean  @default(false)

}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Instructors {
  id          BigInt   @id @default(autoincrement())
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  Name        String   @unique
  Image       String?
  Description String
}

enum paymentStatus {
  Approved
  Rejected
  Pending
}
